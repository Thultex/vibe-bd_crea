    <Element variable="(function(){function shuffledSlot(slot,seed){var p=[];for(var k=0;k&lt;16;k++)p.push(k);var state=(seed*1664525+1013904223)&gt;&gt;&gt;0;for(var i=15;i&gt;0;i--){state=(state*1664525+1013904223)&gt;&gt;&gt;0;var j=state%(i+1);var t=p[i];p[i]=p[j];p[j]=t;}return p[slot];}var logical=shuffledSlot(0,cardIndex);var start=parseInt(bingo_start,10)||1;var end=parseInt(bingo_end,10)||start;var n=Math.max(1,end-start+1);var shift=parseInt(bingo_shift,10)||0;function mod(v,m){return ((v%m)+m)%m;}var id=start+mod(shift+logical,n);var scales=String(symbol_scale_map||'1').split('|').map(function(v){return parseFloat(v)||1;});var correction=scales[id-1]||1;var available=String(symbol_available_map||'').split('|');var exists=available.length?available[id-1]==='1':id&lt;=scales.length;var file=id.toString().padStart(2,'0');if(!exists){AddOverrideField('enabled','false');return '';}AddOverrideField('enabled','true');var factor=correction;var w=Math.round(Element.width*factor);var h=Math.round(Element.height*factor);AddOverrideField('x',Math.round(Element.x+(Element.width-w)/2).toString());AddOverrideField('y',Math.round(Element.y+(Element.height-h)/2).toString());AddOverrideField('width',w.toString());AddOverrideField('height',h.toString());AddOverrideField('rotation','0');return symbol_folder+'/'+file+'.png';})()" type="Graphic" x="582" y="287" width="266" height="266" borderthickness="0" autoscalefont="false" lockaspect="true" keeporiginalsize="false" centerimageonorigin="false" outlinethickness="0" rotation="0" horizontalalign="1" verticalalign="1" colortype="0" opacity="255" tilesize="" mirrortype="0" imagemasksurface="false" lineheight="14" wordspace="0" justifiedtext="false" name="Bingo Symbol 1" font="Arial;12;0;0;0;0" elementcolor="0x000000FF" bordercolor="0x00000000" backgroundcolor="0x00000000" enabled="true" outlinecolor="0x000000FF" gradient="" colormatrix="" />
